sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:conference a bibo:Conference ;
    rdfs:label "Industry Symposium on “AI in Life Sciences and Medicine” – 3rd edition"@en ;
    skos:altLabel "Fraunhofer Industry Symposium"@en ;
    dct:description "Industry Symposium on “AI in Life Sciences and Medicine”, 3rd edition, Bonn, 2026, announced by Fraunhofer SCAI. Event page: https://www.scai.fraunhofer.de/en/events/industry-symposium-ai-life-sciences-3.html"@en .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8888-635X .
}

