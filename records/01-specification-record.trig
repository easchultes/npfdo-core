    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/markdown> ;
    spdx:checksum sub:checksum ;
    dcat:byteSize "45139"^^xsd:nonNegativeInteger ;
    dct:issued "2026-09-27"^^xsd:date .

  sub:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "fde7fc201133b7eaa340fc90ebb9ed8ff5eb96529f198229759a385cd4a8c140" .
}

sub:provenance {
