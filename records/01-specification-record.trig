sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/npfdo/spec/core> a bibo:Specification ;
    rdfs:label "np-FDO core specification"@en ;
    dcat:version "0.1" ;
    dct:creator orcid:0000-0001-8888-635X .

  sub:file fdof:materializes <https://w3id.org/npfdo/spec/core> ;
    dcat:accessURL <https://github.com/easchultes/npfdo-core/blob/b400634b543f2205b6da411886a4cd2a76bc9053/npfdo_core_spec_v0_1_d8.md> ;
